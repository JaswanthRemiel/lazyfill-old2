{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "chrome",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "web",
    "vite.config.ts",
    "vite.content.config.ts",
    "vite.web.config.ts",
    "vitest.config.ts"
  ]
}
